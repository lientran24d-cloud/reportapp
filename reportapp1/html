<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lighthouse English - Quản Lý Nhận Xét Học Sinh</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Quicksand & Nunito -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti for Celebration effects -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            purple: '#4c1d95',
                            darkPurple: '#3b0764',
                            pink: '#ec4899',
                            softPink: '#fce7f3',
                            lightPurple: '#f3e8ff',
                            accent: '#f59e0b',
                            teal: '#0d9488'
                        }
                    },
                    fontFamily: {
                        sans: ['Nunito', 'Quicksand', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #faf5ff;
            background-image: radial-gradient(#e9d5ff 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 2px solid #f3e8ff;
        }
        .header-gradient {
            background: linear-gradient(135deg, #4c1d95 0%, #7e22ce 50%, #ec4899 100%);
        }
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #c084fc;
            border-radius: 10px;
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white; }
            .glass-card { border: none; box-shadow: none; }
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 ease-in-out bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-purple-400">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-xl"></i>
        <span id="toast-message" class="font-bold text-sm">Đã lưu thay đổi thành công!</span>
    </div>

    <!-- EDIT STUDENT MODAL -->
    <div id="student-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl border-4 border-purple-200 overflow-hidden flex flex-col max-h-[90vh]">
            <div class="bg-purple-950 text-white px-6 py-4 flex justify-between items-center">
                <h3 id="modal-title" class="font-black text-lg flex items-center gap-2">
                    <i class="fa-solid fa-user-pen text-pink-400"></i> Chỉnh Sửa Nhận Xét Học Sinh
                </h3>
                <button onclick="closeStudentModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto space-y-4 text-sm font-semibold">
                <input type="hidden" id="edit-std-id">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Họ và tên học sinh</label>
                        <input type="text" id="edit-std-name" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tên Phụ Huynh / Zalo</label>
                        <input type="text" id="edit-std-parent" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Trạng thái vắng</label>
                        <select id="edit-std-absent" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                            <option value="0">Đi học đầy đủ (0)</option>
                            <option value="1">Vắng có phép (01)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Thái độ học tập</label>
                        <input type="text" id="edit-std-attitude" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Avatar (Emoji)</label>
                        <input type="text" id="edit-std-avatar" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold text-center text-xl" value="👧">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tinh thần phát biểu / Xây dựng bài</label>
                    <input type="text" id="edit-std-spirit" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Bài tập về nhà (HW)</label>
                        <input type="text" id="edit-std-hw" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Danh hiệu / Sticker</label>
                        <select id="edit-std-sticker" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-bold">
                            <option value="Super Star 🌟">Super Star 🌟</option>
                            <option value="Active Speaker 🎤">Active Speaker 🎤</option>
                            <option value="Homework Hero 📝">Homework Hero 📝</option>
                            <option value="Good Try 👍">Good Try 👍</option>
                            <option value="Star Student ⭐">Star Student ⭐</option>
                        </select>
                    </div>
                </div>

                <!-- Star Ratings -->
                <div class="bg-purple-50 p-4 rounded-2xl border border-purple-100 grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div>
                        <label class="block text-[11px] font-extrabold text-purple-900 uppercase mb-1">Từ vựng (1-5)</label>
                        <input type="number" min="1" max="5" id="edit-vocab" class="w-full px-3 py-2 rounded-xl border border-purple-200 bg-white text-center font-bold">
                    </div>
                    <div>
                        <label class="block text-[11px] font-extrabold text-purple-900 uppercase mb-1">Phát âm (1-5)</label>
                        <input type="number" min="1" max="5" id="edit-speaking" class="w-full px-3 py-2 rounded-xl border border-purple-200 bg-white text-center font-bold">
                    </div>
                    <div>
                        <label class="block text-[11px] font-extrabold text-purple-900 uppercase mb-1">Thái độ (1-5)</label>
                        <input type="number" min="1" max="5" id="edit-attitude-score" class="w-full px-3 py-2 rounded-xl border border-purple-200 bg-white text-center font-bold">
                    </div>
                    <div>
                        <label class="block text-[11px] font-extrabold text-purple-900 uppercase mb-1">Bài tập (1-5)</label>
                        <input type="number" min="1" max="5" id="edit-hw-score" class="w-full px-3 py-2 rounded-xl border border-purple-200 bg-white text-center font-bold">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nhận xét chi tiết của giáo viên</label>
                    <textarea id="edit-std-comment" rows="3" class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-200 focus:border-purple-600 focus:outline-none font-semibold"></textarea>
                </div>
            </div>

            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex justify-end gap-3">
                <button onclick="closeStudentModal()" class="px-5 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl transition-colors">
                    Hủy
                </button>
                <button onclick="saveStudentModal()" class="px-5 py-2.5 bg-purple-700 hover:bg-purple-800 text-white font-bold rounded-xl shadow-md transition-all">
                    Lưu Thay Đổi
                </button>
            </div>
        </div>
    </div>

    <!-- EXPORT CODE MODAL -->
    <div id="export-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-3xl rounded-3xl shadow-2xl border-4 border-purple-200 overflow-hidden flex flex-col max-h-[90vh]">
            <div class="bg-purple-950 text-white px-6 py-4 flex justify-between items-center">
                <h3 class="font-black text-lg flex items-center gap-2">
                    <i class="fa-solid fa-code text-pink-400"></i> Xuất Dữ Liệu / Sao Chép JSON
                </h3>
                <button onclick="closeExportModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto space-y-4">
                <p class="text-xs font-bold text-slate-600">
                    Toàn bộ dữ liệu bạn vừa chỉnh sửa được lưu trên trình duyệt này. Bạn có thể copy đoạn JSON dưới đây để sao lưu hoặc cập nhật vào mã nguồn khi đưa lên GitHub Pages.
                </p>
                <textarea id="export-json-area" rows="12" class="w-full p-4 rounded-xl border-2 border-slate-200 font-mono text-xs bg-slate-50 focus:outline-none" readonly></textarea>
            </div>

            <div class="bg-slate-50 px-6 py-4 border-t border-slate-200 flex justify-between items-center">
                <button onclick="resetToDefaultData()" class="px-4 py-2 bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold text-xs rounded-xl transition-colors">
                    <i class="fa-solid fa-rotate-right mr-1"></i> Khôi phục mặc định ban đầu
                </button>
                <div class="flex gap-2">
                    <button onclick="closeExportModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-xs rounded-xl">Đóng</button>
                    <button onclick="copyExportJson()" class="px-5 py-2 bg-pink-600 hover:bg-pink-700 text-white font-bold text-xs rounded-xl shadow-md">
                        <i class="fa-solid fa-copy mr-1"></i> Copy Dữ Liệu JSON
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="app" class="w-full max-w-7xl mx-auto p-3 sm:p-6">

        <!-- BRAND HEADER -->
        <header class="header-gradient rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-6 relative overflow-hidden border-4 border-white/20">
            <!-- Decorative Background SVGs -->
            <div class="absolute -right-10 -bottom-10 opacity-15 pointer-events-none">
                <i class="fa-solid fa-graduation-cap text-9xl"></i>
            </div>
            <div class="absolute right-1/3 -top-10 opacity-10 pointer-events-none">
                <i class="fa-solid fa-star text-9xl"></i>
            </div>

            <div class="flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
                <!-- Logo & Brand Name -->
                <div class="flex items-center gap-4 text-center md:text-left">
                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-white p-2 shadow-lg flex items-center justify-center shrink-0 border-2 border-pink-300 transform rotate-2 hover:rotate-0 transition-transform">
                        <div class="text-center">
                            <i class="fa-solid fa-lighthouse text-3xl sm:text-4xl text-purple-700"></i>
                            <span class="block text-[10px] font-black text-pink-600 uppercase tracking-tighter mt-1">LIGHTHOUSE</span>
                        </div>
                    </div>
                    <div>
                        <div class="inline-flex items-center gap-2 bg-pink-500/30 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase border border-pink-300/30 text-pink-100 mb-1">
                            <i class="fa-solid fa-award text-yellow-300"></i> LIGHTHOUSE ACADEMY • BY MS LINDA
                        </div>
                        <h1 class="text-2xl sm:text-4xl font-black tracking-tight drop-shadow-md" id="header-title">
                            BẢNG NHẬN XÉT HỌC TẬP
                        </h1>
                        <p class="text-purple-100 text-xs sm:text-sm font-medium mt-1 flex items-center justify-center md:justify-start gap-2">
                            <i class="fa-regular fa-calendar-check"></i> <span id="header-date">Lịch học: 19:30 Thứ Ba – Thứ Sáu</span>
                        </p>
                    </div>
                </div>

                <!-- Navigation Controls & Teacher Edit Mode Toggle -->
                <div id="controls-panel" class="no-print bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20 flex flex-col sm:flex-row gap-3 w-full md:w-auto items-center">
                    <div>
                        <label class="block text-xs font-bold text-purple-200 mb-1 uppercase tracking-wider">Chọn Lớp Học</label>
                        <select id="class-select" onchange="changeClass(this.value)" class="w-full sm:w-44 bg-white text-slate-800 font-bold text-sm px-4 py-2.5 rounded-xl border-2 border-pink-300 focus:outline-none shadow-md cursor-pointer">
                            <option value="flyers7">Lớp Flyers 7</option>
                            <option value="movers2">Lớp Movers 2</option>
                            <option value="starters1">Lớp Starters 1</option>
                            <option value="gs3">Global Success 3</option>
                            <option value="gs4">Global Success 4</option>
                            <option value="phonics">Jolly Phonics</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-purple-200 mb-1 uppercase tracking-wider">Buổi Học / Unit</label>
                        <select id="lesson-select" onchange="changeLesson(this.value)" class="w-full sm:w-48 bg-white text-slate-800 font-bold text-sm px-4 py-2.5 rounded-xl border-2 border-pink-300 focus:outline-none shadow-md cursor-pointer">
                            <!-- Populated dynamically -->
                        </select>
                    </div>

                    <!-- Teacher Mode Button -->
                    <div class="sm:self-end">
                        <button id="teacher-mode-btn" onclick="toggleTeacherMode()" class="w-full sm:w-auto px-4 py-2.5 bg-amber-400 hover:bg-amber-500 text-slate-900 font-black text-xs rounded-xl shadow-lg transition-all flex items-center justify-center gap-1.5 uppercase tracking-wide">
                            <i class="fa-solid fa-lock" id="teacher-mode-icon"></i> <span id="teacher-mode-text">Chế độ Sửa</span>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- TEACHER EDIT TOOLBAR (Appears when Teacher Mode is ON) -->
        <div id="teacher-toolbar" class="hidden no-print bg-amber-100 border-2 border-amber-300 p-4 rounded-2xl mb-6 flex flex-wrap items-center justify-between gap-4 shadow-md">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
                <div>
                    <span class="text-xs font-black text-amber-900 uppercase block">ĐANG BẬT CHẾ ĐỘ GIÁO VIÊN CHỈNH SỬA</span>
                    <span class="text-xs font-medium text-amber-800">Bạn có thể sửa tên lớp, lịch học, thêm/xóa học sinh hoặc bấm Sửa ở từng bé.</span>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <button onclick="openClassSettings()" class="px-4 py-2 bg-white hover:bg-amber-50 text-amber-900 font-bold text-xs rounded-xl border border-amber-300 shadow-sm flex items-center gap-1.5">
                    <i class="fa-solid fa-pen-to-square"></i> Sửa Tên Lớp & Lịch
                </button>
                <button onclick="addNewStudent()" class="px-4 py-2 bg-purple-700 hover:bg-purple-800 text-white font-bold text-xs rounded-xl shadow-sm flex items-center gap-1.5">
                    <i class="fa-solid fa-user-plus"></i> Thêm Học Sinh Mới
                </button>
                <button onclick="openExportModal()" class="px-4 py-2 bg-pink-600 hover:bg-pink-700 text-white font-bold text-xs rounded-xl shadow-sm flex items-center gap-1.5">
                    <i class="fa-solid fa-code"></i> Xuất / Backup JSON
                </button>
            </div>
        </div>

        <!-- VIEW CONTAINER 1: CLASS DASHBOARD -->
        <main id="class-dashboard" class="space-y-6">
            
            <!-- Quick Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="glass-card p-4 rounded-2xl flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 block uppercase">Sĩ Số Lớp</span>
                        <span id="stat-total" class="text-2xl font-black text-purple-900">0</span>
                    </div>
                </div>

                <div class="glass-card p-4 rounded-2xl flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 block uppercase">Đi Học Đầy Đủ</span>
                        <span id="stat-present" class="text-2xl font-black text-emerald-600">0</span>
                    </div>
                </div>

                <div class="glass-card p-4 rounded-2xl flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 block uppercase">Tải Bài Tốt</span>
                        <span id="stat-good-hw" class="text-2xl font-black text-amber-600">0</span>
                    </div>
                </div>

                <div class="glass-card p-4 rounded-2xl flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-pink-100 text-pink-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-slate-400 block uppercase">Học Sinh Xuất Sắc</span>
                        <span id="stat-top-student" class="text-sm font-black text-pink-600 truncate max-w-[110px] block">--</span>
                    </div>
                </div>
            </div>

            <!-- Class Report Table Card -->
            <div class="glass-card rounded-3xl shadow-xl border border-purple-100 overflow-hidden">
                <div class="px-6 py-4 bg-purple-900 text-white flex flex-col sm:flex-row justify-between items-center gap-3">
                    <div class="flex items-center gap-3">
                        <span id="class-badge" class="px-3 py-1 bg-pink-500 text-white font-extrabold text-xs rounded-full uppercase">LỚP FLYERS 7</span>
                        <h2 id="lesson-title-display" class="font-black text-lg sm:text-xl">Báo Cáo Buổi Học</h2>
                    </div>
                    <div class="text-xs font-bold bg-white/10 px-3 py-1.5 rounded-lg border border-white/20">
                        <i class="fa-solid fa-circle-info text-pink-300 mr-1"></i> Bấm "Báo Cáo" để xem thẻ chi tiết của từng bé
                    </div>
                </div>

                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-purple-950 text-purple-100 font-extrabold text-xs uppercase tracking-wider">
                                <th class="p-4 text-center w-14">STT</th>
                                <th class="p-4 min-w-[160px]">Học Sinh</th>
                                <th class="p-4 min-w-[140px]">Phụ Huynh / Zalo</th>
                                <th class="p-4 text-center min-w-[90px]">Vắng</th>
                                <th class="p-4 min-w-[140px]">Thái Độ Học Tập</th>
                                <th class="p-4 min-w-[220px]">Tinh Thần Học Bài</th>
                                <th class="p-4 min-w-[150px]">Bài Tập Về Nhà</th>
                                <th class="p-4 text-center min-w-[180px] no-print">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody id="student-table-body" class="divide-y divide-purple-100 text-sm font-semibold">
                            <!-- Dynamic Rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <!-- VIEW CONTAINER 2: INDIVIDUAL STUDENT CARD -->
        <main id="student-card-view" class="hidden space-y-6">
            <div class="no-print flex justify-between items-center bg-white p-4 rounded-2xl shadow-md border border-purple-100">
                <button onclick="backToClassView()" class="px-4 py-2 bg-purple-100 hover:bg-purple-200 text-purple-900 rounded-xl font-bold text-sm flex items-center gap-2 transition-colors">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Bảng Danh Sách Lớp
                </button>
                <div class="flex gap-2">
                    <button onclick="copyZaloMessage()" class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-xl font-bold text-sm flex items-center gap-2 shadow-md transition-all">
                        <i class="fa-solid fa-comment-dots"></i> Copy Nhận Xét Zalo
                    </button>
                    <button onclick="window.print()" class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold text-sm flex items-center gap-2 shadow-md transition-all">
                        <i class="fa-solid fa-print"></i> In / Xuất PDF
                    </button>
                </div>
            </div>

