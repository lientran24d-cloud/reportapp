        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            const classParam = urlParams.get('class');
            const studentParam = urlParams.get('student');
            const modeParam = urlParams.get('mode');

            if (classParam && database[classParam]) {
                currentClassKey = classParam;
            }

            if (modeParam === 'teacher') {
                toggleTeacherMode();
            }

            document.getElementById('class-select').value = currentClassKey;
            loadLessonsForClass(currentClassKey);

            if (studentParam) {
                currentStudentId = parseInt(studentParam);
                showStudentCard(currentStudentId);
            } else {
                renderClassDashboard();
            }
        };

        function loadLessonsForClass(classKey) {
            const classData = database[classKey];
            const lessonSelect = document.getElementById('lesson-select');
            lessonSelect.innerHTML = '';

            classData.lessons.forEach((lesson) => {
                const opt = document.createElement('option');
                opt.value = lesson.id;
                opt.textContent = lesson.name;
                lessonSelect.appendChild(opt);
            });

            currentLessonId = classData.lessons[0].id;
        }

        function changeClass(classKey) {
            currentClassKey = classKey;
            loadLessonsForClass(classKey);
            updateURLParameter('class', classKey);
            updateURLParameter('student', null);
            currentStudentId = null;
            renderClassDashboard();
        }

        function changeLesson(lessonId) {
            currentLessonId = lessonId;
