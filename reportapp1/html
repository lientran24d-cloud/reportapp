            document.getElementById('edit-hw-score').value = std.scoreHW;
            document.getElementById('edit-std-comment').value = std.comment;
            document.getElementById('edit-std-avatar').value = std.avatar;

            document.getElementById('student-modal').classList.remove('hidden');
        }

        function closeStudentModal() {
            document.getElementById('student-modal').classList.add('hidden');
        }

        function saveStudentModal() {
            const id = parseInt(document.getElementById('edit-std-id').value);
            const classData = database[currentClassKey];
            const std = classData.students.find(s => s.id === id);
            if (!std) return;

            std.name = document.getElementById('edit-std-name').value;
            std.parent = document.getElementById('edit-std-parent').value;
            std.absent = parseInt(document.getElementById('edit-std-absent').value);
            std.attitude = document.getElementById('edit-std-attitude').value;
            std.spirit = document.getElementById('edit-std-spirit').value;
            std.hw = document.getElementById('edit-std-hw').value;
            std.sticker = document.getElementById('edit-std-sticker').value;
            std.scoreVocab = parseInt(document.getElementById('edit-vocab').value) || 5;
            std.scoreSpeaking = parseInt(document.getElementById('edit-speaking').value) || 5;
            std.scoreAttitude = parseInt(document.getElementById('edit-attitude-score').value) || 5;
            std.scoreHW = parseInt(document.getElementById('edit-hw-score').value) || 5;
            std.comment = document.getElementById('edit-std-comment').value;
            std.avatar = document.getElementById('edit-std-avatar').value;

            saveDatabase();
            closeStudentModal();
            renderClassDashboard();
            showToast("Đã lưu thông tin học sinh thành công!");
        }

        // CLASS SETTINGS (EDIT CLASS NAME & SCHEDULE)
        function openClassSettings() {
            const classData = database[currentClassKey];
            const newName = prompt("Nhập tên hiển thị cho lớp:", classData.className);
            if (newName === null) return;
            const newSched = prompt("Nhập lịch học (ví dụ: 19:30 Thứ Ba – Thứ Sáu):", classData.schedule);
            if (newSched === null) return;

            classData.className = newName;
            classData.schedule = newSched;
            saveDatabase();
            renderClassDashboard();
            showToast("Đã cập nhật thông tin lớp học!");
        }

        // OPEN INDIVIDUAL STUDENT CARD
        function openStudentView(studentId) {
            updateURLParameter('student', studentId);
            showStudentCard(studentId);
            confetti({ particleCount: 70, spread: 60, origin: { y: 0.6 } });
        }

        function showStudentCard(studentId) {
            currentStudentId = studentId;
            const classData = database[currentClassKey];
            const std = classData.students.find(s => s.id === studentId);

            if (!std) {
                renderClassDashboard();
                return;
            }

            document.getElementById('class-dashboard').classList.add('hidden');
            document.getElementById('student-card-view').classList.remove('hidden');

            document.getElementById('card-class-name').innerText = classData.className.toUpperCase();
            document.getElementById('card-student-name').innerText = std.name;
            document.getElementById('card-parent-name').innerText = std.parent;
            document.getElementById('card-avatar').innerText = std.avatar;
            document.getElementById('card-teacher-comment').innerText = `"${std.comment}"`;
            
            document.getElementById('sticker-title').innerText = std.sticker.toUpperCase();
            document.getElementById('card-badge-sticker').innerText = std.sticker;

            const renderStars = (score) => {
                let stars = '';
                for(let i=1; i<=5; i++) { stars += i <= score ? '★' : '☆'; }
                return stars;
            };

            document.getElementById('stars-vocab').innerText = renderStars(std.scoreVocab);
            document.getElementById('stars-vocab-text').innerText = `${std.scoreVocab}/5 ⭐`;
            document.getElementById('stars-speaking').innerText = renderStars(std.scoreSpeaking);
            document.getElementById('stars-speaking-text').innerText = `${std.scoreSpeaking}/5 ⭐`;
            document.getElementById('stars-attitude').innerText = renderStars(std.scoreAttitude);
            document.getElementById('stars-attitude-text').innerText = `${std.scoreAttitude}/5 ⭐`;
            document.getElementById('stars-hw').innerText = renderStars(std.scoreHW);
            document.getElementById('stars-hw-text').innerText = `${std.scoreHW}/5 ⭐`;
        }

        function backToClassView() {
            updateURLParameter('student', null);
            renderClassDashboard();
        }

        // COPY ZALO MESSAGE
        function copyZaloMessage() {
            const classData = database[currentClassKey];
            const std = classData.students.find(s => s.id === currentStudentId);
            if (!std) return;

            const text = `🌟 [LIGHTHOUSE ENGLISH ACADEMY] - BÁO CÁO HỌC TẬP
----------------------------------
Dear Phụ huynh bé ${std.name} (${std.parent}),
Ms Linda xin gửi nhận xét học tập của con tại lớp ${classData.className}:

- Thái độ học tập: ${std.attitude} (${std.spirit})
- Bài tập về nhà: ${std.hw}
- Danh hiệu buổi học: ${std.sticker}

💬 Nhận xét chi tiết từ Ms Linda:
"${std.comment}"

👉 Xem báo cáo trực tuyến chi tiết của bé tại:
${window.location.href}

Cảm ơn Phụ huynh đã luôn đồng hành cùng trung tâm! ❤️`;

            copyToClipboard(text, "Đã sao chép tin nhắn Zalo sẵn sàng gửi cho PH!");
        }

        // EXPORT / BACKUP JSON
        function openExportModal() {
            document.getElementById('export-json-area').value = JSON.stringify(database, null, 2);
            document.getElementById('export-modal').classList.remove('hidden');
        }

        function closeExportModal() {
            document.getElementById('export-modal').classList.add('hidden');
        }

        function copyExportJson() {
            const area = document.getElementById('export-json-area');
            area.select();
            document.execCommand('copy');
            showToast("Đã copy dữ liệu JSON thành công!");
        }

        function resetToDefaultData() {
            if (confirm("Bạn có chắc muốn khôi phục dữ liệu về mặc định ban đầu không? Mọi chỉnh sửa của bạn sẽ bị mất.")) {
                localStorage.removeItem('lighthouse_english_db_v2');
                database = JSON.parse(JSON.stringify(defaultDatabase));
                renderClassDashboard();
                closeExportModal();
                showToast("Đã khôi phục dữ liệu mặc định thành công!");
            }
        }

        function copyToClipboard(text, successMessage) {
            const tempInput = document.createElement("textarea");
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast(successMessage);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function updateURLParameter(key, value) {
            const url = new URL(window.location.href);
            if (value) {
                url.searchParams.set(key, value);
            } else {
                url.searchParams.delete(key);
            }
            window.history.pushState({}, '', url.toString());
        }
    </script>
</body>
</html>
